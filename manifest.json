{
  "schemaVersion": 1,
  "abiVersion": 1,
  "id": "arbitrum",
  "name": "Arbitrum One",
  "ticker": "ETH",
  "version": "0.1.5",
  "kind": "account",
  "networkId": "arbitrum-mainnet",
  "decimals": 18,
  "capabilities": [
    "derive",
    "validate",
    "snapshot",
    "nodeRequest",
    "assets",
    "importAsset",
    "setAssetVisibility",
    "prepareTransfer",
    "send"
  ],
  "runtime": {
    "type": "javascript",
    "entry": "load.cjs",
    "binaryPlatforms": {
      "linux-x64": "altbase_arbitrum.so",
      "win32-x64": "altbase_arbitrum.dll"
    }
  },
  "icon": "icon.png"
}
